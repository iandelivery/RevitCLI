<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>RevitCliBridge.Abstractions</RootNamespace>
		<Description>Plugin interfaces for RevitCliBridge — enables third-party command handler development without Revit API dependency</Description>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Semantic versioning for the plugin SDK. This project is
		     netstandard2.0 with no Revit API reference, so the binary is
		     identical across every supported Revit version — a single version
		     line (not the Nice3point {RevitYear}.{Major}.{Minor} scheme) is
		     sufficient. Bump this in lockstep with the release tag. The
		     package version, assembly identity and file version all track
		     1.10.0. -->
		<Version>1.10.0</Version>
		<AssemblyVersion>1.10.0.0</AssemblyVersion>
		<FileVersion>1.10.0.0</FileVersion>

		<!-- NuGet package metadata -->
		<PackageId>RevitCliBridge.Abstractions</PackageId>
		<Authors>RevitCliBridge Contributors</Authors>
		<Company>RevitCliBridge</Company>
		<Copyright>Copyright (c) 2026 RevitCliBridge Contributors</Copyright>
		<PackageTags>revit;autodesk;cli;bridge;plugin;automation;api</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/iandelivery/RevitCLI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/iandelivery/RevitCLI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Icon intentionally omitted: no logo asset yet. Add
		     <PackageIcon>icon.png</PackageIcon> + an <ItemGroup>
		     <None Include="icon.png" Pack="true" PackagePath="\" />
		     when a logo exists. -->

		<!-- Strong name so third-party addins can reference this assembly
		     without type-identity splits when the bridge loads its own copy.
		     Required for the cross-addin plugin registration pattern. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>RevitCliBridge.Abstractions.snk</AssemblyOriginatorKeyFile>
		<!-- Emit the XML doc file next to the DLL. Consumers (company plugins)
		     get IntelliSense from it, and it is the input for API doc
		     generators such as XMLDoc2Markdown / DocFX. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Don't fail the build if a public member lacks XML docs; the doc
		     file is still emitted for the members that do have them. -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<!-- Ship the package README so it renders on the NuGet package page. -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>