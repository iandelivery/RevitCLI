<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>RevitCliBridge.Abstractions</RootNamespace>
		<Description>Plugin interfaces for RevitCliBridge — enables third-party command handler development without Revit API dependency</Description>
		<Configurations>Debug R19;Debug R20;Debug R21;Debug R22</Configurations>
		<Configurations>$(Configurations);Release R19;Release R20;Release R21;Release R22</Configurations>
	</PropertyGroup>

	<!-- Per-Revit-version configurations select the Revit year that feeds
	     the Nice3point-style version composition below. -->
	<PropertyGroup Condition="$(Configuration.Contains('R19'))">
		<RevitVersion>2019</RevitVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R20'))">
		<RevitVersion>2020</RevitVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R21'))">
		<RevitVersion>2021</RevitVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R22'))">
		<RevitVersion>2022</RevitVersion>
	</PropertyGroup>
	<!-- Plain Debug/Release builds (e.g. from the test project) fall back
	     to the latest supported Revit year so the composed version stays
	     valid. -->
	<PropertyGroup>
		<RevitVersion Condition="'$(RevitVersion)' == ''">2022</RevitVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Versioning follows the Nice3point convention used by Revit NuGet
		     packages (e.g. Nice3point.Revit.Toolkit 2025.0.3):
		     {RevitYear}.{Major}.{Minor}, e.g. 2022.1.5. The package is built
		     once per supported Revit version so multi-version plugin solutions
		     can pin Version="$(RevitVersion).*" uniformly across their Revit
		     dependencies. AssemblyVersion pins the minor component to 0 so
		     minor/patch releases within a major line do not require binding
		     redirects. -->
		<Major>1</Major>
		<Minor>6</Minor>
		<Patch>0</Patch>
		<Version>$(RevitVersion).$(Major).$(Minor)</Version>
		<AssemblyVersion>$(RevitVersion).$(Major).0.0</AssemblyVersion>
		<FileVersion>$(RevitVersion).$(Major).$(Minor).$(Patch)</FileVersion>

		<!-- NuGet package metadata -->
		<PackageId>RevitCliBridge.Abstractions</PackageId>
		<Authors>RevitCliBridge Contributors</Authors>
		<Company>RevitCliBridge</Company>
		<Copyright>Copyright (c) 2026 RevitCliBridge Contributors</Copyright>
		<PackageTags>revit;autodesk;cli;bridge;plugin;automation;api</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/iandelivery/RevitCLI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/iandelivery/RevitCLI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Icon intentionally omitted: no logo asset yet. Add
		     <PackageIcon>icon.png</PackageIcon> + an <ItemGroup>
		     <None Include="icon.png" Pack="true" PackagePath="\" />
		     when a logo exists. -->

		<!-- Strong name so third-party addins can reference this assembly
		     without type-identity splits when the bridge loads its own copy.
		     Required for the cross-addin plugin registration pattern. -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>RevitCliBridge.Abstractions.snk</AssemblyOriginatorKeyFile>
		<!-- Emit the XML doc file next to the DLL. Consumers (company plugins)
		     get IntelliSense from it, and it is the input for API doc
		     generators such as XMLDoc2Markdown / DocFX. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Don't fail the build if a public member lacks XML docs; the doc
		     file is still emitted for the members that do have them. -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<!-- Ship the package README so it renders on the NuGet package page. -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
